# Variáveis de ambiente
#
# Todas começam com NEXT_PUBLIC_ porque ficam embutidas no bundle enviado ao navegador
# (o Next.js expõe qualquer variável com esse prefixo ao código client-side) - por isso
# nenhum segredo deve ser colocado aqui.

# URL base da API (feal-biblioteca-api). Em desenvolvimento local, normalmente
# http://localhost:3001 (ajuste conforme a porta configurada na API).
NEXT_PUBLIC_API_HOST="http://localhost:3001"

# Timeout, em milissegundos, aplicado a toda chamada feita à API.
NEXT_PUBLIC_API_CALL_TIMEOUT_IN_MS="15000"

# Domínio público onde o site é servido, sem o protocolo (ex.: biblioteca.feal.org.br).
# Usado para montar URLs canônicas e metadados de SEO/Open Graph.
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"
